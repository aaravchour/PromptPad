    <file alias="dark-document.svg">assets/dark-document.svg</file>
    <file alias="dark-template.svg">assets/dark-template.svg</file>
    <file alias="dark-save.svg">assets/dark-save.svg</file>
    <file alias="dark-preview.svg">assets/dark-preview.svg</file>
    <file alias="dark-settings.svg">assets/dark-settings.svg</file>
