    <file alias="light-search.svg">assets/light-search.svg</file>
    <file alias="light-all.svg">assets/light-all.svg</file>
    <file alias="light-folder.svg">assets/light-folder.svg</file>
    <file alias="light-document.svg">assets/light-document.svg</file>
    <file alias="light-template.svg">assets/light-template.svg</file>
    <file alias="light-save.svg">assets/light-save.svg</file>
    <file alias="light-preview.svg">assets/light-preview.svg</file>
    <file alias="light-settings.svg">assets/light-settings.svg</file>
    <file alias="dark-ellipsis.svg">assets/dark-ellipsis.svg</file>
    <file alias="dark-copy.svg">assets/dark-copy.svg</file>
    <file alias="dark-plus.svg">assets/dark-plus.svg</file>
    <file alias="dark-close.svg">assets/dark-close.svg</file>
    <file alias="dark-search.svg">assets/dark-search.svg</file>
